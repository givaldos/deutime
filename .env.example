# Safe for the browser. Use the publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only elevated key. It bypasses RLS and may only be imported from
# server-only modules. New hosted projects use the sb_secret_... format.
SUPABASE_SECRET_KEY=your-secret-key

# Bearer aleatório (mínimo 32 caracteres) para o executor interno do WhatsApp.
# O endpoint permanece somente em dry-run até o piloto autorizar efeitos reais.
WHATSAPP_WORKER_SECRET=

# AWS SES v2 para avisos de novo cadastro. Use uma chave IAM exclusiva com
# apenas ses:SendEmail na identidade remetente verificada; nunca use root.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=no-reply@deutime.app
SES_SENDER_NAME=DeuTime
SES_CONFIGURATION_SET=

# Credencial server-only usada exclusivamente para validar X-Twilio-Signature.
# Nunca exponha como NEXT_PUBLIC_* nem registre seu valor em logs.
TWILIO_AUTH_TOKEN=

# Piloto operacional: "off" por padrão. O modo "sandbox" ainda não habilita
# o entrypoint live; apenas valida a configuração para a próxima fatia.
WHATSAPP_PILOT_MODE=off
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_CONTENT_SID_EVENT_CALL_V1=
TWILIO_CONTENT_SID_EVENT_CALL_CARD_V1=
TWILIO_CONTENT_SID_EVENT_CALL_CARD_V2=
TWILIO_CONTENT_SID_EVENT_CALL_CARD_FIRST_REMEMBER_V2=
TWILIO_CONTENT_SID_EVENT_CALL_CARD_LAST_REMEMBER_V2=
TWILIO_CONTENT_SID_EVENT_SCHEDULE_CHANGE_V1=
TWILIO_TEMPLATE_PROFILE=sandbox_appointment
WHATSAPP_PILOT_TEAM_ID=
WHATSAPP_PILOT_RECIPIENT=

# Coorte única autorizada a exibir o controle operacional do cartão público.
# Server-only; ausente mantém a interface e a action inertes.
EVENT_SHARE_PILOT_TEAM_ID=

# Coorte única autorizada a exibir o controle operacional de campeonatos.
# Server-only; ausente mantém a interface e a action inertes.
CHAMPIONSHIP_PILOT_TEAM_ID=

# Coorte única autorizada para a agenda profissional da R13. Ausente mantém
# interface, RPCs novas e controle operacional inertes para todos os times.
R13_PILOT_TEAM_ID=

# Canonical application URL used for validated redirects and metadata.
# Keep localhost in development; production uses https://deutime.app.
APP_URL=http://localhost:3000

# Required before enabling anonymous athlete registration in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
